  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Interaction.InspectableObject
  inspectionId: Barrier
  firstInspection:
  - A concrete barrier, poured over something that wanted to grow. It's cold to the
    touch, like a shoulder turned away.
  - '* There''s a faint warmth behind it. Like someone crying very quietly.'
  repeatInspection:
  - '* Still sealed. The statues hold the key, somehow.'
  specialInspectionAt: 0
