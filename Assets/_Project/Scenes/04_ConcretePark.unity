  m_Script: {fileID: 11500000, guid: 581c4b9ba8c164723bbbf6efea7372aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Gameplay.StoryEvent
  trigger: 1
  requiredFlag: hack2_done
  delay: 1.5
  phoneSender: BYTE
  phoneMessages:
  - the core is next. its loud in there. stay close.
  lines:
  - Hey! I followed the sound of someone being kind. It's rare enough to echo.
  - I've been delivering care packages for months. Never opened one. Never thought
    one could be addressed to me.
  - ...Mind if I come with you to the Core? I think I need to stop running in circles.
  - '* (KIRA joined you.)'
  speaker: {fileID: 11400000, guid: d3c4f6749e13c4609beb77b4ac184875, type: 2}
  sequence: {fileID: 0}
  flagToSet: kira_joined
  onFired:
    m_PersistentCalls:
      m_Calls: []
