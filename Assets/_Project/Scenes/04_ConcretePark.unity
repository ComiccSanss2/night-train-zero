  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eaca2b573c63c41189c8f5980d410ea1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Interaction.InspectableObject
  inspectionId: Byte_Park
  firstInspection:
  - This park used to have kids in it. Now it has statues and a pigeon with a spending
    problem.
  - Read the plaques. Sad things always leave instructions.
  repeatInspection:
  - first. then. last. {p}im a cat, not a puzzle book.
  - statues are just people who stopped halfway through a sentence. {p}{small}dont
    stop halfway.{/small}
  - kira hums when she thinks nobodys listening. {p}always the same song. {p}{small}i
    think its a lullaby.{/small}
  - you looked at the station sign for a long time back there. {p}{small}home is
    a direction, not a place. or whatever. i read it on a mug.{/small}
  - if this goes bad, i want you to know something. {p=1}your shoelace is untied.
    {p}{small}...gotcha.{/small}
  specialInspectionAt: 0
  specialInspection: []
  cycleRepeat: 1
  speaker: {fileID: 11400000, guid: 5728d75f900e24ef693e529c50a8886e, type: 2}
