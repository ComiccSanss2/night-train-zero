  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Hacking.HackableObstacle
  encounterTitle: MEMORY_PURGE.exe  //  'OLDEST FILES FIRST'
  speaker: {fileID: 11400000, guid: 5e5025d89b1fb4739baa98f9dfeeada6, type: 2}
  introLines:
  - '* Behind me, Byte sits down in the aisle and faces the grey.'
  - '* Byte, from the back: {p}go. ill be loud about it.'
  - OLDEST FILES FIRST.
  waves:
  - pattern: 10
    duration: 9
    intensity: 1.05
    surrender: 0
  - pattern: 3
    duration: 9
    intensity: 1.25
    surrender: 0
  - pattern: 4
    duration: 9
    intensity: 1.35
    surrender: 0
  - pattern: 5
    duration: 10
    intensity: 1.3
    surrender: 1
  puzzles: []
  resolutionLines:
  - '* The static lets go of the door.'
  - '* Behind me, the aisle is empty.'
  portraitTarget: {fileID: 1261425194}
  portraitDistance: 3.2
  betweenRoundLines:
  - '* Somewhere behind me, a collar beeps. {p}Once.'
  - '* The collar beeps again. {p}{small}Fainter.{/small}'
  - '* I can''t hear it anymore.'
  tauntLines:
  - OLDEST FILES FIRST.
  - A CAT. HOW SENTIMENTAL.
  - HE WAS NEVER REAL.
  - LETTING GO IS EFFICIENT.
  - YOU CANNOT OUTRUN THIS.
  musicOverride: {fileID: 0}
  fadeCompanion: 1
  companionLabel: byte
  requiredFlag: byte_stays
  lockedLines:
  - '* The door to the next carriage is sealed with static. {p}Something at the back
    is getting closer.'
  flagOnResolved: ghostline_done
  hideOnResolved:
  - {fileID: 1261425193}
  - {fileID: 165192037}
  showOnResolved:
