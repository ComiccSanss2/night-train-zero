  - label: Close
    cameraPoint: {fileID: 2045801437}
    cut: 0
    travelDuration: 3
    travelEase: 2
    holdDuration: 0.3
    fieldOfView: 22
    dialogue: {fileID: 0}
    narrationLines:
    - I AM WHAT THIS CITY BUILT SO IT WOULD STOP FEELING TIRED. I REMOVE THE FRICTION.
    - NO MORE MISSING HOME. NO MORE STATIC. NO MORE ANYTHING.
    narrationSpeaker: {fileID: 11400000, guid: 5e5025d89b1fb4739baa98f9dfeeada6, type: 2}
