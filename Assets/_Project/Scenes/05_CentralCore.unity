    cut: 0
    travelDuration: 3
    travelEase: 2
    holdDuration: 0.5
    fieldOfView: 20
    dialogue: {fileID: 0}
    narrationLines:
    - '* Between us, a box floats in the air. Box fourteen. The one I never opened.'
    - '* It''s labeled: leo_last_summer.mem. CORRUPTED.'
