    travelEase: 2
    holdDuration: 0.3
    fieldOfView: 30
    dialogue: {fileID: 0}
    narrationLines:
    - WELCOME, LEO.
    - YOUR EMOTIONAL LATENCY IS UNACCEPTABLE. YOU CARRY THREE YEARS OF UNSENT REPLIES.
    narrationSpeaker: {fileID: 11400000, guid: 5e5025d89b1fb4739baa98f9dfeeada6, type: 2}
