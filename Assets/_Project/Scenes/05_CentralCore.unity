  - '* Night Train Zero. The doors are open. {p}It''s waiting for me. One last time.'
  - '* Behind me, the Algorithm hums. It''s not attacking anymore. {p}It''s just
    watching. Like it''s waiting for my answer too.'
  speaker: {fileID: 0}
  sequence: {fileID: 0}
  flagToSet: board_last_train
  onFired:
    m_PersistentCalls:
      m_Calls: []
