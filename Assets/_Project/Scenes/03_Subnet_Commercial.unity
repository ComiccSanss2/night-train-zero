  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Interaction.InspectableObject
  inspectionId: FreedCommuter
  firstInspection:
  - I'm going to take a lunch break. A real one. With a sandwich and everything.
  - Thank you for... not fighting me. Nobody's ever not fought me.
  - My place is just down the street. 0451. {p}Go in, if you want. The door's open.
    {p}{small}I haven't been home in... I don't know.{/small}
  repeatInspection:
  - Did you know the sky here is pink? I never looked up before.
  specialInspectionAt: 0
  specialInspection: []
