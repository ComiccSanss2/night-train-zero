  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Interaction.TokenMachine
  machineId: claw
  cost: 2
  prompt: A claw machine full of plush cats. {p}One of them looks a LOT like Byte.
    {p}Play for 2 tokens?
  playOption: "[Play  \u25CA2]"
  leaveOption: '[Leave]'
  playingLines:
  - '* The claw wobbles down. {p}{shake}Grabs...{/shake}'
  brokeLine: '* You pat your pockets. {p}Not enough tokens.'
  prizes:
  - reward: 
    weight: 45
    line: '* ...air. {p}It grabbed air. Very confidently.'
  - reward: ramen
    weight: 25
    line: '* A Cup Ramen?! {p}That wasn''t even in there.'
  - reward: potion
    weight: 15
    line: '* A Fizzy Potion rolls into the chute. {p}{bounce}Nice.{/bounce}'
  - reward: plush_cat
    weight: 15
    line: '* The Byte-looking plush! It wobbles... {p}and drops into the chute!'
  guaranteedOnTry: 3
  guaranteedReward: plush_cat
  guaranteedLine: '* The claw grabs the Byte-looking plush. It wobbles... {p}{bounce}and
    drops it in the chute!{/bounce} {p}Byte pretends not to see.'
