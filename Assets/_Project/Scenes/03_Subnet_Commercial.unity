  m_Script: {fileID: 11500000, guid: fdd26bbf34be6d64889ea3b7b67556ed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.UI.ShopCounter
  shopName: NEON MART  //  OPEN 24/7
  stock:
  - potion
  - megapotion
  - ramen
  keeper: {fileID: 11400000, guid: a92e1477e6432824598993f32d1e1430, type: 2}
  firstGreeting:
  - Welcome to NEON MART! {p}Open 24/7. {p}{small}Mostly the 7.{/small}
  - I'm Sunny. Night shift. {p}{slow}Every shift is the night shift down here.{/slow}
  - We take metro tokens. {p}You get them by calming down angry feelings. {p}{small}Gently.
    Don't punch the feelings.{/small}
  - 'Fun fact: I''ve never seen the sun. {p}My parents named me Sunny anyway. {p}{wave}Optimists.{/wave}'
  greeting:
  - Oh hey, it's you! {p}My favorite customer. {p}{small}My only customer, but still.{/small}
  - If you see a cat with a screen on his collar, tell him he still owes me for a
    can of tuna.
  welcomeGiftLine: First time? Have a welcome bonus. {p}{small}Corporate makes me
    say that. I mean it, though.{/small}
  visitedFlag: shop_visited
  audioSource: {fileID: 1281330709}
  moveClip: {fileID: 8300000, guid: 1230da8ef02494df6b0310e9f8817ad0, type: 3}
  buyClip: {fileID: 8300000, guid: 7a7b6b1378cd84731b629cfe5e406b3d, type: 3}
  errorClip: {fileID: 8300000, guid: 61d5082e44a424475913171394d1ddb2, type: 3}
