  m_Script: {fileID: 11500000, guid: eaca2b573c63c41189c8f5980d410ea1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Interaction.InspectableObject
  inspectionId: Timetable
  firstInspection:
  - 'DEPARTURES. Line 3: cancelled. Line 7: delayed. Line 9: delayed indefinitely,
    like everything else.'
  - 'At the bottom, a line flickers that wasn''t there a second ago: <color=#FF4FD8>NIGHT
    TRAIN ZERO - PLATFORM 0 - 00:00 - ON TIME</color>.'
  - '* On time. That makes one of us.'
  repeatInspection:
  - NIGHT TRAIN ZERO. On time. The only thing in this city that is.
  speaker: {fileID: 0}
  textEffect: 0
