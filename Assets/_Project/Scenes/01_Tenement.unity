  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Interaction.InspectableObject
  inspectionId: Mirror
  firstInspection:
  - A cracked mirror. The crack runs right through your reflection, like it's trying
    to split you into a before and an after.
  - You look away first.
  repeatInspection:
  - Still cracked. Still you. Both of those feel like problems.
  specialInspectionAt: 3
  specialInspection:
  - You look again. {p}The crack has moved. {p}{slow}It runs a little to the left
    of you now.{/slow}
  - '* Like it''s making room.'
  cycleRepeat: 0
  speaker: {fileID: 0}
  textEffect: 0
  sequenceOverride: {fileID: 0}
  flagOnInspect: inspected_mirror
  requiredFlag: 
  singleUse: 0
