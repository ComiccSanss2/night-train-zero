  m_Name: Byte_Fountain
  m_EditorClassIdentifier: Assembly-CSharp::Subnet.Dialogue.DialogueSequence
  startNodeId: 
  nodes:
  - id: 
    speaker: {fileID: 0}
    text: The fountain's been dry for years. {p}Someone left a coin in it anyway.
    effect: 0
    requiredFlag: 
    flagToSet: 
    choices: []
    nextNodeId: 
  - id: 
    speaker: {fileID: 11400000, guid: 5728d75f900e24ef693e529c50a8886e, type: 2}
    text: hey. {p}sit for a sec.
    effect: 0
    requiredFlag: 
    flagToSet: 
    choices: []
    nextNodeId: 
  - id: 
    speaker: {fileID: 11400000, guid: 5728d75f900e24ef693e529c50a8886e, type: 2}
    text: tell me something good about home. {p}one thing. {small}dont make it a
      whole thing.{/small}
    effect: 0
    requiredFlag: 
    flagToSet: 
    choices:
    - text: '[Mia''s crayon drawings on the fridge]'
      nextNodeId: mia
      flagToSet: memory_drawings
    - text: '[The bakery that opened at 5 a.m.]'
      nextNodeId: bakery
      flagToSet: memory_bakery
    - text: '[The last train home, all the lights off]'
      nextNodeId: train
      flagToSet: memory_train
    nextNodeId: 
  - id: mia
    speaker: {fileID: 11400000, guid: 759cf262cfc184cd88c287d6915f9b34, type: 2}
    text: Mia used to draw me. Always with a giant head. {p}She said it's because
      I think too much.
    effect: 0
    requiredFlag: 
    flagToSet: 
    choices: []
    nextNodeId: after
  - id: bakery
    speaker: {fileID: 11400000, guid: 759cf262cfc184cd88c287d6915f9b34, type: 2}
    text: There was a bakery under our flat. At five in the morning the whole street
      smelled like bread. {p}I'd pretend I was awake on purpose.
    effect: 0
    requiredFlag: 
    flagToSet: 
    choices: []
    nextNodeId: after
  - id: train
    speaker: {fileID: 11400000, guid: 759cf262cfc184cd88c287d6915f9b34, type: 2}
    text: The last train home. Everyone asleep, every light off except the sign.
      {p}It felt like the city was holding its breath. {small}For me.{/small}
    effect: 0
    requiredFlag: 
    flagToSet: 
    choices: []
    nextNodeId: after
  - id: after
    speaker: {fileID: 0}
    text: Byte doesn't make a joke. {p}He just listens.
    effect: 0
    requiredFlag: 
    flagToSet: 
    choices: []
    nextNodeId: 
  - id: 
    speaker: {fileID: 11400000, guid: 5728d75f900e24ef693e529c50a8886e, type: 2}
    text: '{slow}ok.{/slow} {p=1.2}keep that one.'
    effect: 0
    requiredFlag: 
    flagToSet: fountain_talk;+closeness
